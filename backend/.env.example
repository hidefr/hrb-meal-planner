# =========================================================
# TasteCraft Configuration
# =========================================================

# LLM Configuration (OpenAI-compatible)
# Point this to your Hermes agent endpoint (e.g. Ollama, vLLM, LM Studio, or local runner)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=hermes
LLM_MODEL=hermes-3-llama-3.1-8b

# Or if using cloud LLM (OpenAI / OpenRouter / Gemini):
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# Telegram Bot (Optional, leave blank if only using Web PWA)
# Obtain from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Host and Port
HOST=0.0.0.0
PORT=8000
